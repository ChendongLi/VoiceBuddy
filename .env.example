# Copy this file to .env and fill in your real API keys.
# Never commit your populated .env to version control.

DEEPGRAM_API_KEY="your-deepgram-api-key"
CLAUDE_API_KEY="your-claude-api-key"
CARTESIA_API_KEY="your-cartesia-api-key"
CARTESIA_VOICE_ID="your-cartesia-voice-id"

# Twilio
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="your-twilio-phone-number"
TWILIO_WEBHOOK_HOST="your-cloud-run-url"

# Database
# Local dev: SQLite (no Docker, no setup — just a file)
DATABASE_URL="sqlite+aiosqlite:///./voicebuddy_dev.db"
# Production (Cloud Run): uncomment and set this instead
# DATABASE_URL="postgresql+asyncpg://user:password@host:5432/voicebuddy"

# Server
# Local dev: 127.0.0.1 (default, avoids WebSocket issues with 0.0.0.0)
# Production (Cloud Run): set to 0.0.0.0
# SERVER_HOST=0.0.0.0

# Audio Configuration (16-bit PCM for Deepgram compatibility)
AUDIO_SAMPLE_RATE=16000
AUDIO_ENCODING=pcm_s16le
AUDIO_CONTAINER=wav
AUDIO_CHANNELS=1

# Google OAuth (Calendar API)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/callback
